# ==============================================================================
# Hey Man Diamond LLC - Environment Configuration Example
# Copy this file to .env and fill in your values.
# ==============================================================================

# Client API Base URL (leave blank for same-origin)
VITE_API_BASE_URL=

# Supabase Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Flomiz Inventory Pull API
FLOMIZ_API_KEY=your-flomiz-api-key
FLOMIZ_BASE_URL=https://api.flomiz.com

# Instagram Reels & Media API
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# Google reCAPTCHA v2 (Optional in development - defaults to Google's public test keys)
# For production, register your domain at https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
